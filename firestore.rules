rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return me().get('role', 'donor');
    }

    function isAdmin() {
      return isAuthenticated() && myRole() == 'admin';
    }

    function isVolunteer() {
      return isAuthenticated() && myRole() in ['volunteer', 'admin'];
    }

    function myDistricts() {
      return me().get('volunteerDistricts', []);
    }

    // Admins, and volunteers with no districts assigned, manage all of Kerala.
    function managesAll() {
      return isAdmin() || (isVolunteer() && myDistricts().size() == 0);
    }

    function managesDistrict(district) {
      return managesAll() || (isVolunteer() && district in myDistricts());
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Users collection: donors, volunteers and admins, plus donors without the app
    match /users/{userId} {
      // Fields only volunteers/admins may set on someone's profile.
      function staffOnlyFields() {
        return ['role', 'volunteerDistricts', 'verified', 'status', 'notes', 'createdBy', 'hasAccount'];
      }

      // District-limited volunteers must always query by district.
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        managesAll() ||
        (isVolunteer() && resource.data.district in myDistricts())
      );

      allow create: if isAuthenticated() && (
        // Self sign-up always starts as an unverified donor
        (isOwner(userId) &&
         request.resource.data.get('role', 'donor') == 'donor' &&
         request.resource.data.get('verified', false) == false &&
         !request.resource.data.keys().hasAny(['volunteerDistricts', 'notes'])) ||
        // Volunteers add donors who don't use the app
        (managesDistrict(request.resource.data.get('district', '')) &&
         request.resource.data.role == 'donor' &&
         request.resource.data.hasAccount == false &&
         !request.resource.data.keys().hasAny(['visibility']))
      );

      allow update: if isAuthenticated() && (
        (isOwner(userId) && !changedKeys().hasAny(staffOnlyFields())) ||
        // Only the donor decides whether the public can find them.
        (isAdmin() && !changedKeys().hasAny(['visibility'])) ||
        // Volunteers manage plain donors in their districts, but can't change roles
        (managesDistrict(resource.data.get('district', '')) &&
         managesDistrict(request.resource.data.get('district', '')) &&
         resource.data.get('role', 'donor') == 'donor' &&
         !changedKeys().hasAny(['role', 'volunteerDistricts', 'visibility']))
      );

      allow delete: if isAdmin();
    }

    // Donation history; users.lastDonation is kept in sync by the app
    match /donations/{donationId} {
      allow read: if isAuthenticated() && (
        resource.data.donorId == request.auth.uid || isVolunteer()
      );
      allow create: if isAuthenticated() &&
                   request.resource.data.recordedBy == request.auth.uid && (
        request.resource.data.donorId == request.auth.uid ||
        managesDistrict(request.resource.data.get('district', ''))
      );
      allow update: if false;
      allow delete: if isAuthenticated() && managesDistrict(resource.data.get('district', ''));
    }

    // Notification audit log, written only by the server (firebase-admin)
    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Donors asked directly for a request (web/src/app/api/donors/ask), server only
    match /donorAsks/{askId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Blood requests collection
    match /bloodRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                   request.resource.data.requesterId == request.auth.uid &&
                   request.resource.data.status == 'open';
      allow update: if isAuthenticated() &&
                   request.resource.data.requesterId == resource.data.requesterId && (
        isOwner(resource.data.requesterId) ||
        managesDistrict(resource.data.get('district', ''))
      );
      allow delete: if isAdmin();
    }
  }
}
